# ─────────────────────────────────────────────────────────────────────────────
#  Crescendo e Aprendendo — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env preenchido.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Banco de dados (Neon PostgreSQL) ─────────────────────────────────────────
# DATABASE_URL usa a string COM pooling (pgbouncer) — é a que o app usa.
# DIRECT_DATABASE_URL é a conexão direta — usada apenas por migrations, porque
# o pooler em modo transação não suporta os comandos que uma migration precisa.
#
# Provisionando pela Vercel (Storage → Neon)? As variáveis entram sozinhas no
# projeto. Confira o nome da conexão direta que a integração criou — costuma ser
# DATABASE_URL_UNPOOLED — e adicione DIRECT_DATABASE_URL com o mesmo valor.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require&pgbouncer=true&connection_limit=3"
DIRECT_DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ── Autenticação (Auth.js) ───────────────────────────────────────────────────
# Gere com:  openssl rand -base64 48
AUTH_SECRET=""
AUTH_URL=http://localhost:3000

# ── Tutor IA — a Voz do Farol (Bíblia Vol. 1 Cap. 8) ─────────────────────────
# Chave do provedor de modelo. Sem ela, a plataforma continua ensinando com
# conteúdo curado — a IA é amplificador, nunca dependência (docs/10 §8).
ANTHROPIC_API_KEY=""
TUTOR_MODEL=claude-sonnet-5
# Teto de gasto por criança por dia, em centavos de dólar.
TUTOR_DAILY_BUDGET_CENTS=50

# ── Infraestrutura opcional em desenvolvimento ───────────────────────────────
# Sem Redis o sistema cai para o banco (degradação graciosa).
REDIS_URL=""
BLOB_READ_WRITE_TOKEN=""
# Assinatura HMAC dos consumidores de fila. openssl rand -hex 32
JOB_SIGNING_SECRET=""
